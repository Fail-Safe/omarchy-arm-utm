#!/bin/bash
# Shortcut for connecting to the VM over SSH during development.
#   OM_HOST=192.168.64.20 OM_USER=builder ./scripts/omssh "command"
# Obtain the IP with:  utmctl ip-address "Omarchy ARM"
: "${OM_USER:=builder}"
: "${OMARCHY_LANG:=$(bash "$(dirname "$0")/../build-omarchy-arm.sh" --print-language)}"
if [[ -z ${OM_HOST:-} ]]; then
  if [[ $OMARCHY_LANG == es ]]; then echo "falta OM_HOST (la IP de la VM)" >&2
  else echo "OM_HOST is required (the VM's IP address)" >&2; fi
  exit 1
fi
exec ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR -o ConnectTimeout=10 "$OM_USER@$OM_HOST" "$@"
